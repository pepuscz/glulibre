// Copy to xDripConfigOverride.xcconfig and use your own signing identity.
// For upgrades, preserve the exact team/bundle IDs from the existing install.
XDRIP_DEVELOPMENT_TEAM = YOUR_TEAM_ID
MAIN_APP_DISPLAY_NAME = GluLibre
MAIN_APP_BUNDLE_IDENTIFIER = com.example.glulibre
// Keep the pre-rename display name when upgrading an existing installation.
BLUETOOTH_RESTORE_NAME = Libre Debug
